{
    "name": "wyo",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "packageManager": "pnpm@12.10.1",
    "scripts": {
        "tools:install": "bash scripts/tools/install.sh",
        "generate": "bash scripts/generate.sh",
        "generate:check": "bash scripts/generate.sh --check",
        "dev": "bash scripts/dev.sh",
        "build": "vite build && bash scripts/go/build.sh",
        "preview": "vite preview",
        "test:headless": "vitest --no-watch",
        "go:test": "bash scripts/go/test.sh",
        "test:coverage": "vitest --no-watch --coverage && bash scripts/go/coverage.sh",
        "coverage:enforce": "node scripts/coverage-check.cjs && bash scripts/go/coverage-enforce.sh",
        "test:e2e": "playwright test",
        "test:e2e:install": "playwright install chromium",
        "lint": "eslint . --max-warnings 0 && bash scripts/go/lint.sh",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p e2e/tsconfig.json && bash scripts/go/build-check.sh",
        "format": "prettier --write \"src/**/*.{js,ts,svelte,json,css,md}\" \"e2e/**/*.{js,ts,json,md}\" \"messages/*.json\" && bash scripts/go/format.sh",
        "precommit": "pnpm generate:check && pnpm lint && pnpm check && pnpm test:coverage && pnpm coverage:enforce && pnpm build",
        "prepare": "husky",
        "release": "commit-and-tag-version"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.0.1",
        "@commitlint/config-conventional": "^21.0.1",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.63.0",
        "@sveltejs/adapter-static": "^3.0.11",
        "@sveltejs/kit": "^2.70.3",
        "@sveltejs/vite-plugin-svelte": "^7.1.2",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/vite": "^4.2.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/svelte": "^5.2.4",
        "@types/node": "^24.12.3",
        "@vitest/coverage-v8": "^5.0.1",
        "clsx": "^2.1.1",
        "commit-and-tag-version": "^13.2.1",
        "cross-env": "10.1.0",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-svelte": "^3.23.0",
        "globals": "^17.12.0",
        "husky": "^9.1.7",
        "jsdom": "^29.1.1",
        "openapi-typescript": "^7.13.0",
        "phosphor-svelte": "^3.1.0",
        "prettier": "^3.5.3",
        "prettier-plugin-svelte": "^4.1.1",
        "svelte": "^5.55.10",
        "svelte-check": "^4.4.8",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.3.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.1",
        "vite": "^8.0.14",
        "vitest": "^5.0.1"
    },
    "dependencies": {
        "sveltekit-superforms": "^2.30.1",
        "zod": "^4.4.3"
    }
}
