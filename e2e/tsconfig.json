{
    "compilerOptions": {
        "target": "ES2022",
        "module": "nodenext",
        "lib": ["ES2022", "DOM"],
        "moduleResolution": "nodenext",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "noEmit": true,
        "types": ["node"]
    },
    "include": ["**/*.ts"],
    "exclude": ["node_modules", "dist", "coverage", "build", ".svelte-kit", ".agents"]
}
